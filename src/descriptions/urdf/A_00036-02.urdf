      <parent link="Chain4_link_virtual_1"/>
      <child link="Chain4_link_virtual_2"/>
      <axis xyz="0 1 0"/>
      <limit effort="99999.0" lower="-7.0" upper="7.0" velocity="99999.0"/>
    </joint>
    <joint name="Chain4_3" type="revolute">
      <parent link="Chain4_link_virtual_2"/>
      <child link="Chain4_top_link"/>
      <axis xyz="1 0 0"/>
      <limit effort="99999.0" lower="-7.0" upper="7.0" velocity="99999.0"/>
    </joint>
    <joint name="Chain4_4" type="prismatic">
      <limit effort="1000.0" lower="0.0" upper="2.0" velocity="10.0"/>
      <parent link="Chain4_top_link"/>
      <child link="Chain4_bottom_link"/>
      <origin xyz="0 0 0"/>
      <axis xyz="0 0 -1"/>
    </joint>
    <transmission name="Chain4_transmission">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="Chain4_1"/>
      <actuator name="Chain4_actuator">
        <mechanicalReduction>10.0</mechanicalReduction>
        <efficiency>0.94</efficiency>
        <inertia>1.5e-05</inertia>
      </actuator>
    </transmission>
    <!-- constraints -->
    <constraint name="Chain4_constraint" type="spherical_joint">
      <parent link="Chain4_bottom_link"/>
      <parent_origin rpy="0 0 0" xyz="0 0 0"/>
      <parent_axis xyz="1 0 0"/>
      <child link="tool0"/>
      <child_origin rpy="0 0 0" xyz="0 0 0"/>
      <child_axis xyz="0 1 0"/>
    </constraint>
    <!-- tool joint-->
    <link name="tool0_virtual">
    </link>
    <link name="tool1_virtual">
    </link>
    <link name="tool2_virtual">
    </link>
    <link name="tool3_virtual">
    </link>
    <link name="tool4_virtual">
    </link>
    <joint name="tool_joint_0" type="prismatic">
      <parent link="base_link"/>
      <child link="tool0_virtual"/>
      <axis xyz="1 0 0"/>
      <origin xyz="0 0 0"/>
      <limit effort="99999.0" lower="-9999.0" upper="9999.0" velocity="9999.0"/>
    </joint>
    <joint name="tool_joint_1" type="prismatic">
      <parent link="tool0_virtual"/>
      <child link="tool1_virtual"/>
      <axis xyz="0 1 0"/>
      <origin xyz="0 0 0"/>
      <limit effort="99999.0" lower="-9999.0" upper="9999.0" velocity="9999.0"/>
    </joint>
    <joint name="tool_joint_2" type="prismatic">
      <parent link="tool1_virtual"/>
      <child link="tool2_virtual"/>
      <axis xyz="0 0 1"/>
      <limit effort="99999.0" lower="-9999.0" upper="9999.0" velocity="9999.0"/>
    </joint>
    <joint name="tool_joint_3" type="continuous">
      <parent link="tool2_virtual"/>
      <child link="tool3_virtual"/>
      <axis xyz="1 0 0"/>
      <origin xyz="0 0 0"/>
      <limit effort="10.0" velocity="2.0"/>
    </joint>
    <joint name="tool_joint_4" type="continuous">
      <parent link="tool3_virtual"/>
      <child link="tool4_virtual"/>
      <axis xyz="0 1 0"/>
      <origin xyz="0 0 0"/>
      <limit effort="10.0" velocity="2.0"/>
    </joint>
    <joint name="tool_joint_5" type="continuous">
      <parent link="tool4_virtual"/>
      <child link="tool0"/>
      <axis xyz="0 0 1"/>
      <origin xyz="0 0 0"/>
      <limit effort="10.0" velocity="2.0"/>
    </joint>
    <joint name="tool_joint_gamma" type="continuous">
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <axis xyz="0 0 1"/>
      <parent link="tool0"/>
      <child link="tool_holder"/>
      <mimic joint="Chain4_1" multiplier="1.0"/>
    </joint>
  </robot>
